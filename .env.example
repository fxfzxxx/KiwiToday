# ---------- database ----------
# Supabase: Project Settings -> Database -> Connection string (region: Sydney ap-southeast-2)
# Local dev: docker run -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgis/postgis:16-3.4
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kiwitoday

# ---------- ingestion sources ----------
# https://www.eventfinda.co.nz/api/v2/index  (free key, commercial use allowed)
EVENTFINDA_USERNAME=
EVENTFINDA_PASSWORD=

# https://developer.ticketmaster.com/  (Discovery API, free key)
TICKETMASTER_API_KEY=

# ---------- enrichment (optional; pipeline degrades gracefully without it) ----------
# Used to generate zh titles/summaries + category classification. Haiku is enough.
ANTHROPIC_API_KEY=
ENRICH_MODEL=claude-haiku-4-5-20251001

# ---------- web ----------
# MapTiler free tier, or point at your own Protomaps tiles on R2
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
NEXT_PUBLIC_API_BASE=
